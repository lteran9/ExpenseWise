@baseUrl = http://localhost:5153
@accessToken = replace-with-a-token-from-User-Authenticate
@groupKey = replace-with-a-group-key

### List expenses for a group member
GET {{baseUrl}}/Expense/List?groupKey={{groupKey}}
Authorization: Bearer {{accessToken}}

### Reject anonymous expense-list access
GET {{baseUrl}}/Expense/List?groupKey={{groupKey}}
