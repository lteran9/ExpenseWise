@{
   ViewData["Title"] = "Home Page";
}

<h1 class="display-4 text-center">Welcome</h1>
<hr />
<!-- What is ExpenseWise -->
<div class="row mb-5">
   <div class="col text-center">
      <h2 class="fw-bold">What is ExpenseWise?</h2>
      <p class="text-muted mt-3">
         ExpenseWise is a small-group expense ledger. It records who paid for shared bills, how each bill is split, and the repayments your group makes outside the app.
      </p>
   </div>
</div>

<!-- Features -->
<div class="row g-4">
   <div class="col-md-4">
      <div class="card h-100 shadow-sm">
         <div class="card-body text-center">
            <div class="feature-icon mb-3">
               <i class="bi bi-cash-coin fs-2"></i>
            </div>
            <h5 class="card-title">Track Shared Expenses</h5>
            <p class="card-text">
               Record a USD expense, choose the member who paid, and select the members who share it.
            </p>
         </div>
      </div>
   </div>

   <div class="col-md-4">
      <div class="card h-100 shadow-sm">
         <div class="card-body text-center">
            <div class="feature-icon mb-3">
               <i class="bi bi-clipboard-data fs-2"></i>
            </div>
            <h5 class="card-title">Automatic Balances</h5>
            <p class="card-text">
               Balances combine expenses and recorded repayments so every member can see who owes whom.
            </p>
         </div>
      </div>
   </div>

   <div class="col-md-4">
      <div class="card h-100 shadow-sm">
         <div class="card-body text-center">
            <div class="feature-icon mb-3">
               <i class="bi bi-people fs-2"></i>
            </div>
            <h5 class="card-title">Groups</h5>
            <p class="card-text">
               Create a group for a trip or household and add members who have registered accounts. The organizer records expenses and repayments.
            </p>
         </div>
      </div>
   </div>
</div>

<!-- More Features -->
<div class="row g-4 mt-4">
   <div class="col-md-6">
      <div class="card h-100 shadow-sm">
         <div class="card-body">
            <h5 class="card-title">Equal Splitting</h5>
            <p class="card-text">
               Each expense is split equally, to the cent, among the selected members. Custom, percentage, and weighted splits are not available in this release.
            </p>
         </div>
      </div>
   </div>

   <div class="col-md-6">
      <div class="card h-100 shadow-sm">
         <div class="card-body">
            <h5 class="card-title">See Who Owes Whom</h5>
            <p class="card-text">
               Review member balances and suggested repayments, then record payments your group has already made. ExpenseWise does not move money.
            </p>
         </div>
      </div>
   </div>
</div>