@model ExpenseViewModel
@{
   ViewData["Title"] = "Create Expense";
}

<h1 class="display-4 text-center">Add Expense</h1>
<hr />
<div class="card box-shadow">
   <div class="card-body">
      @if (Model.Members.Count == 0)
      {
         @Html.ValidationSummary()
         <div class="alert alert-warning">Expenses can't be recorded for this group.</div>
         <div class="d-grid">
            <a href="@Url.Action("Index", "Group")" class="btn btn-secondary">Back to groups</a>
         </div>
      }
      else
      {
      <form asp-action="Create" method="post">
         @Html.AntiForgeryToken()
         @Html.ValidationSummary()

         <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <input asp-for="Description" class="form-control" type="text" required />
         </div>
         <div class="mb-3">
            <label asp-for="Amount" class="form-label">Amount (USD)</label>
            <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" placeholder="$" required />
         </div>
         <div class="mb-3">
            <label asp-for="PayerKey" class="form-label">Paid by</label>
            <select asp-for="PayerKey" class="form-select" required>
               <option value="">Select a payer</option>
               @foreach (var member in Model.Members)
               {
                  <option value="@member.Key">@member.Name</option>
               }
            </select>
         </div>
         <fieldset class="mb-3">
            <legend class="form-label">Shared with</legend>
            @foreach (var member in Model.Members)
            {
               <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="ParticipantKeys" value="@member.Key"
                         checked="@Model.ParticipantKeys.Contains(member.Key)" id="participant-@member.Key" />
                  <label class="form-check-label" for="participant-@member.Key">@member.Name</label>
               </div>
            }
         </fieldset>
         <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary">Add Expense</button>
         </div>
         <div class="d-grid">
            <a href="@Url.Action("Index", "Group")" class="btn btn-secondary">Back</a>
         </div>

         <input asp-for="GroupKey" type="hidden" />
         <input asp-for="IdempotencyKey" type="hidden" />
      </form>
      }
   </div>
</div>