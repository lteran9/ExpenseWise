@model ExpenseViewModel
@{
   ViewData["Title"] = "Create Expense";
}

<h1 class="display-4 text-center">Add Expense</h1>
<hr />
<div class="card box-shadow">
   <div class="card-body">
      @if (Model.Members.Count == 0)
      {
         @Html.ValidationSummary()
         <div class="alert alert-warning">Expenses can't be recorded for this group.</div>
         <div class="d-grid">
            <a href="@Url.Action("Index", "Group")" class="btn btn-secondary">Back to groups</a>
         </div>
      }
      else
      {
      <form asp-action="Create" method="post">
         @Html.AntiForgeryToken()
         @Html.ValidationSummary()

         <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <input asp-for="Description" class="form-control" type="text" required />
         </div>
         <div class="mb-3">
            <label asp-for="Amount" class="form-label">Amount (USD)</label>
            <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" placeholder="$" required />
         </div>
         <div class="mb-3">
            <label asp-for="PayerKey" class="form-label">Paid by</label>
            <select asp-for="PayerKey" class="form-select" required>
               <option value="">Select a payer</option>
               @foreach (var member in Model.Members)
               {
                  <option value="@member.Key">@member.Name</option>
               }
            </select>
         </div>
         <fieldset class="mb-3">
            <legend class="form-label">Shared with</legend>
            @foreach (var member in Model.Members)
            {
               <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="ParticipantKeys" value="@member.Key"
                         checked="@Model.ParticipantKeys.Contains(member.Key)" id="participant-@member.Key" />
                  <label class="form-check-label" for="participant-@member.Key">@member.Name</label>
               </div>
            }
         </fieldset>
         <fieldset class="mb-3">
            <legend class="form-label">Split amounts</legend>
            <div class="form-check">
               <input class="form-check-input" type="radio" name="UseCustomAmounts" id="equal-split" value="false"
                      checked="@(!Model.UseCustomAmounts)" />
               <label class="form-check-label" for="equal-split">Split equally</label>
            </div>
            <div class="form-check">
               <input class="form-check-input" type="radio" name="UseCustomAmounts" id="custom-split" value="true"
                      checked="@Model.UseCustomAmounts" aria-controls="custom-amounts" />
               <label class="form-check-label" for="custom-split">Enter custom amounts</label>
            </div>
            <div id="custom-amounts" class="mt-3" hidden="@(!Model.UseCustomAmounts)">
               <p>Enter a USD amount for each selected participant. Amounts must add up to the expense total; $0.00 is allowed.</p>
               @for (var index = 0; index < Model.Members.Count; index++)
               {
                  var member = Model.Members[index];
                  <div class="mb-2">
                     <label class="form-label" for="custom-amount-@member.Key">Custom amount for @member.Name</label>
                     <input class="form-control" type="number" min="0" step="0.01"
                            name="CustomAmounts[@member.Key]" id="custom-amount-@member.Key"
                            value="@Model.CustomAmounts.GetValueOrDefault(member.Key)" />
                  </div>
               }
            </div>
         </fieldset>
         <div class="d-grid mb-3">
            <button type="submit" class="btn btn-primary">Add Expense</button>
         </div>
         <div class="d-grid">
            <a href="@Url.Action("Index", "Group")" class="btn btn-secondary">Back</a>
         </div>

         <input asp-for="GroupKey" type="hidden" />
         <input asp-for="IdempotencyKey" type="hidden" />
      </form>
      }
   </div>
</div>

<script>
   document.querySelectorAll('input[name="UseCustomAmounts"]').forEach((input) => {
      input.addEventListener("change", () => {
         document.getElementById("custom-amounts").hidden =
            document.getElementById("custom-split").checked === false;
      });
   });
</script>